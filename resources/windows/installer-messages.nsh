!ifndef AIONUI_INSTALLER_MESSAGES_NSH
!define AIONUI_INSTALLER_MESSAGES_NSH

!define AIONUI_MSG_INSTALL_FAILED_EN "Pavii.Ai installation failed"

!define AIONUI_MSG_SUGGESTED_ACTION_EN "Suggested action"

!define AIONUI_MSG_DIAGNOSTICS_EN "Diagnostics"

!define AIONUI_MSG_INSTALLER_LOG_EN "Installer log"

!define AIONUI_MSG_SEND_REPORT_EN "Send this installer failure report to the Pavii.Ai team? The report includes the error code and the current installer log."

!define AIONUI_MSG_VERIFY_REQUIRED_FILE_EN "Pavii.Ai installation is incomplete. Missing required file:"
!define AIONUI_MSG_VERIFY_REQUIRED_FILE_ACTION_EN "Please reinstall Pavii.Ai or download a newer installer."

!define AIONUI_MSG_EXTRACT_FAILED_EN "Pavii.Ai could not extract the application files correctly."
!define AIONUI_MSG_EXTRACT_FAILED_ACTION_EN "Download a fresh installer and run it again. If it still fails, send the installer report to the Pavii.Ai team."

!define AIONUI_MSG_BUNDLED_AIONCORE_INCOMPLETE_EN "Pavii.Ai installed, but the bundled Pavii Engine resources are incomplete."
!define AIONUI_MSG_BUNDLED_AIONCORE_INCOMPLETE_ACTION_EN "Download a fresh installer and run it again. If it still fails, send the installer report to the Pavii.Ai team."

!define AIONUI_MSG_DISK_INSUFFICIENT_EN "There is not enough free disk space to install Pavii.Ai."
!define AIONUI_MSG_DISK_INSUFFICIENT_ACTION_EN "Free up space on the drive shown below, then run this installer again. Nothing was changed, so your existing installation (if any) still works."

!define AIONUI_MSG_ARCH_MISMATCH_EN "Installation package architecture mismatch."
!define AIONUI_MSG_ARCH_MISMATCH_ACTION_EN "Download the Pavii.Ai installer that matches this Windows architecture, then run it again."

!define AIONUI_MSG_UNINSTALLER_COPY_LOCKED_EN "Pavii.Ai could not overwrite the installed uninstaller because it is locked."
!define AIONUI_MSG_UNINSTALLER_REBUILD_FAILED_EN "Pavii.Ai could not rebuild the missing installed uninstaller."
!define AIONUI_MSG_UNINSTALLER_REBUILD_MISSING_EN "Pavii.Ai rebuilt the uninstaller, but the rebuilt file is still missing."
!define AIONUI_MSG_UNINSTALLER_REPAIR_ACTION_EN "Close Pavii.Ai, restart Windows if needed, then run this installer again."

!define AIONUI_MSG_OLD_UNINSTALL_FAILED_EN "The previous Pavii.Ai uninstaller returned an error."
!define AIONUI_MSG_OLD_UNINSTALL_ACTION_EN "Close the program listed above, then run this installer again. If no program is listed, restart Windows and run this installer again."

!define AIONUI_MSG_REPLACE_LOCKED_EN "Pavii.Ai could not safely replace the previous installation because files are still open. Your existing installation was left untouched and still works."
!define AIONUI_MSG_ROLLBACK_RESTORED_EN "The update failed partway, so your previous installation was restored and still works."
!define AIONUI_MSG_UNINSTALLER_WRITE_EN "Pavii.Ai could not finish writing its uninstaller file. If this was an update, your previous installation was restored."
!define AIONUI_MSG_PREVIOUS_FILE_OPEN_EN "Pavii.Ai cannot continue because a file in the previous installation is still open."
!define AIONUI_MSG_REMOVE_PREVIOUS_DIR_EN "Pavii.Ai could not remove the previous installation directory."
!define AIONUI_MSG_CLOSE_SHOWN_FILE_ACTION_EN "Close the application using the file shown in the previous message, then run this installer again. If you are not sure what to close, restart Windows and run this installer again."
!define AIONUI_MSG_CLOSE_INSTALL_DIR_ACTION_EN "Close Pavii.Ai and any file browsers in the install directory, then run this installer again."

!define AIONUI_MSG_APP_CANNOT_BE_CLOSED_EN "Pavii.Ai could not finish closing or removing the previous version.$\r$\n$\r$\nClose Pavii.Ai and any program that may be using files in the install folder, then click Retry.$\r$\n$\r$\nIf Retry keeps returning here, click Cancel. The installer will show the failed path, any program reported by Windows Restart Manager, and the installer log."

!define AIONUI_MSG_LOCKER_UNKNOWN_EN "Windows did not identify a specific locking process. Close terminals, editors, and file managers opened in the install folder."
!define AIONUI_MSG_UNKNOWN_PROCESS_EN "unknown process"

!define AIONUI_MSG_FILE_OR_FOLDER_IN_USE_EN "Pavii.Ai cannot continue because a file or folder in the install directory is still in use:"
!define AIONUI_MSG_APPLICATION_USING_IT_EN "Application using it:"
!define AIONUI_MSG_CLOSE_LISTED_RETRY_EN "Close the application listed above, then click Retry. If you are not sure what to close, click Cancel to send the installer log to the Pavii.Ai team."

!define AIONUI_MSG_CLOSE_OR_REMOVE_PREVIOUS_EN "Pavii.Ai could not finish closing or removing the previous version."
!define AIONUI_MSG_MAY_USE_INSTALL_DIR_EN "Another program may still be using files in:"
!define AIONUI_MSG_RETRY_AFTER_CLOSING_DIR_EN "Click Retry after closing Pavii.Ai and any program using that folder. Click Cancel to show the diagnostics and installer log."

!endif

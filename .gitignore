# Build and output directories
dist/
build/
out/
out-fast-builds/

# out/ backups taken by tests/unit/bootstrap/buildWithBuilder.test.ts. A run that
# dies before its restore step leaves one behind, and it is large enough (GBs of
# bundled JS) to swamp lint with errors from minified vendor code.
/.tmp-out-backup-*/

# Keep extension example dist (pre-built distributable assets)
!examples/**/dist/
.webpack/

# Debug and test files
debug.log
test-*.js
!examples/**/test-*.js
diagnose-*.js

